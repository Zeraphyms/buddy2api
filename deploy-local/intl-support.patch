+# 国内（.cn）与国际（.ai）使用不同的后端网关，必须按凭据里的 domain 路由。
+# 国内凭据打到 .ai 网关、或国际凭据打到 copilot.tencent.com，都会被 401 拒绝。
+CN_BACKEND = "https://copilot.tencent.com"
+INTL_BACKEND = "https://www.workbuddy.ai"
+CN_BILLING_HOST = "https://www.codebuddy.cn"
+
+# 兼容旧引用（默认走国内网关）
+BACKEND = CN_BACKEND
 DEFAULT_DOMAIN = "www.codebuddy.cn"
 USER_AGENT = "codebuddy2openai/2.0"
 
+# 国际后端要求首条消息必须是 system，否则返回 11128。
+# 该占位文本刻意不含任何厂商/模型自称，避免被 filter_system_identity 整句删除。
+INTL_SYSTEM_PLACEHOLDER = "Respond accurately and concisely."
+
+
+def is_intl_domain(domain) -> bool:
+    """凭据 domain 是否属于国际版（workbuddy.ai / codebuddy.ai）。"""
+    d = str(domain or "").lower()
+    return "workbuddy.ai" in d or "codebuddy.ai" in d
+
+
+def backend_for(domain) -> str:
+    """按凭据 domain 选择对话后端网关。"""
+    return INTL_BACKEND if is_intl_domain(domain) else CN_BACKEND
+
+
+def billing_base_for(domain) -> str:
+    """按凭据 domain 选择积分/签到服务地址。"""
+    host = INTL_BACKEND if is_intl_domain(domain) else CN_BILLING_HOST
+    return f"{host}/v2/billing/meter/"
+
+
+def backend_from_headers(headers) -> str:
+    """从请求头 X-Domain 推断后端网关。
+
+    比直接读凭据对象更稳健：管理后台的账号池、独立转换器、以及测试替身
+    都只需提供 get_headers()。
+    """
+    return backend_for((headers or {}).get("X-Domain"))
+
+
+def ensure_system_first(body: dict, domain) -> dict:
+    """国际后端要求首条消息为 system；缺失时补一条占位 system。
+
+    只在国际域名下生效，且必须在 filter_system_identity / 脱敏之后调用，
+    否则占位消息本身可能被过滤掉。
+    """
+    if not is_intl_domain(domain):
+        return body
+    msgs = body.get("messages")
+    if not isinstance(msgs, list) or not msgs:
+        return body
+    first = msgs[0]
+    if isinstance(first, dict) and first.get("role") == "system":
+        return body
+    new_body = dict(body)
+    new_body["messages"] = [{"role": "system", "content": INTL_SYSTEM_PLACEHOLDER}] + msgs
+    return new_body
+
+
