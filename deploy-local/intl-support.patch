+.models-foot{font-size:11px;margin:16px 0 30px;max-width:900px;line-height:1.9}
+@media(max-width:760px){.models-head{flex-direction:column}.models-actions{width:100%}.models-actions .secondary{flex:1}}
+.key-reveal{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
+.key-reveal .secret-value{padding:7px 11px;font:11px Consolas,monospace;max-width:420px;overflow-wrap:anywhere}
+.key-reveal .copy-button{white-space:nowrap}
+#guide-key{overflow-wrap:anywhere}
+.acct-models{margin-bottom:18px}
+.acct-models .section-toolbar{margin-bottom:12px}
+.acct-models h3{font-size:16px;margin:0 0 4px}
+.acct-models .section-toolbar p{font-size:11px;color:#8a9490;margin:0}
+.acct-model-row{padding:14px 0;border-bottom:1px solid var(--line)}
+.acct-model-row:last-child{border-bottom:0;padding-bottom:0}
+.acct-model-head{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
+.acct-model-head .acct-model-count{margin-left:auto;font-size:11px}
+.acct-model-head .acct-probe{font-size:11px;padding:7px 12px}
+.acct-model-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
+.model-chip{background:#f1f5ef;color:#41694f;border-radius:5px;padding:3px 8px;font-size:10px}
+.acct-model-no{font-size:10px;margin-top:8px}
+.acct-model-banner{margin:0 0 14px;font-size:11px;line-height:1.9}
+.acct-model-banner code{background:#00000010;padding:1px 5px;border-radius:4px}
+.acct-model-head .acct-use{font-size:11px;padding:7px 12px}
