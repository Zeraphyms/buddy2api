# workbuddy2api 本地部署配置模板
#
# 用法：把本文件复制为同目录下的 .env，然后按下面说明填写。
#   PowerShell:  Copy-Item .env.example .env
#   cmd:         copy .env.example .env
#
# 说明：
#   .env 已被 .gitignore 排除，不会提交到仓库；请勿把填好的 .env 外传。
#   如果直接运行 start-admin 而缺少 .env，脚本会自动生成一份随机配置，
#   生成的密钥会打印在控制台（只显示一次）——所以这一步可以省略。

# 管理后台登录密钥，长度至少 20 个字符（后台登录用）
# 生成方式： python -c "import secrets; print(secrets.token_urlsafe(36))"
ADMIN_KEY=

# 客户端调用用的 API Key，建议以 sk-wb- 开头（填进客户端的那把）
# 生成方式： python -c "import secrets; print('sk-wb-' + secrets.token_urlsafe(32))"
CODEBUDDY2OPENAI_KEY=

# 服务监听端口，默认 8787；同一端口只能跑一个实例
PORT=8787

# 可选：纯 HTTP 下若后台登录不上（浏览器拒绝保存 Secure Cookie），
# 启动时改用 start-admin.ps1 -InsecureCookie，或在此设为 1。
# ADMIN_REVEAL_INITIAL_KEY=1